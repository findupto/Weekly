{
  "name": "mk-pizza-pos",
  "version": "2.1.0",
  "private": true,
  "description": "MK Pizza & Ice Bar role-based POS with web, mobile and Windows clients",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "desktop": "electron .",
    "dist:win": "electron-builder --win",
    "mobile:sync": "npx cap sync",
    "mobile:android": "npx cap open android",
    "security:audit": "npm audit --audit-level=high"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "zod": "^4.0.17"
  },
  "devDependencies": { "@capacitor/cli": "^7.4.3", "@capacitor/core": "^7.4.3", "@capacitor/android": "^7.4.3", "electron": "^38.1.0", "electron-builder": "^26.0.12" },
  "build": { "appId": "pk.mkpizza.pos", "productName": "MK Pizza POS", "files": ["**/*", "!node_modules/.cache/**"], "win": { "target": ["nsis", "portable"] }, "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true } }
}
